{
  "name": "next-grafana-auth",
  "version": "1.0.3",
  "description": "Embed Grafana dashboards in Next.js with auth-proxy authentication",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./component": {
      "types": "./dist/component.d.ts",
      "import": "./dist/component.mjs",
      "require": "./dist/component.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "packageManager": "npm@12.0.2",
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "^22.22.2 || ^24.15.0 || >=26.0.0",
      "onFail": "error"
    }
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest",
    "test:run": "vitest run",
    "lint": "eslint src/**/*.ts src/**/*.tsx",
    "typecheck": "tsc --noEmit",
    "smoke:dist": "node scripts/smoke-built-package.mjs",
    "smoke:component": "node scripts/smoke-built-package.mjs --component",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "nextjs",
    "grafana",
    "auth",
    "proxy",
    "dashboard",
    "embedding",
    "next-auth",
    "authentication"
  ],
  "author": "Joe Byounghern Kim",
  "license": "MIT",
  "peerDependencies": {
    "next": ">=15.0.0",
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "eslint": "^10.8.1",
    "jsdom": "^30.0.1",
    "tsup": "^8.5.1",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.66.0",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=18.18.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/joe-byounghern-kim/next-grafana-auth.git"
  },
  "bugs": {
    "url": "https://github.com/joe-byounghern-kim/next-grafana-auth/issues"
  },
  "homepage": "https://github.com/joe-byounghern-kim/next-grafana-auth#readme"
}
